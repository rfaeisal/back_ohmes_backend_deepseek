# .env.example — Template environment variables
# Copy ke .env dan isi sesuai environment (dev/staging/prod).
# JANGAN commit .env (sudah di-gitignore).
# Detail: docs/14-deployment-infra.md §5.

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_ENV=development                        # development | staging | production
NEXT_PUBLIC_APP_NAME="MES + WMS Hummer"
NEXT_PUBLIC_BASE_URL=http://localhost:3000              # ganti sesuai env
NEXT_PUBLIC_APP_VERSION=0.1.0                           # bump per release

# =============================================================================
# DATABASE
# =============================================================================
# Format: postgres://<user>:<pass>@<host>:<port>/<db>?<params>
# Dev: local Docker Postgres.
# Prod: Neon / Supabase / RDS — pakai pooling connection string.
#
# PENTING (RLS): DATABASE_URL = role RUNTIME non-superuser (mes_app) supaya
# policy RLS benar-benar difilter. Role ini dibuat oleh migrasi 0008 dan diberi
# grant DML. JANGAN pakai role superuser/owner tabel di sini — owner bypass RLS.
DATABASE_URL=postgres://mes_app:mes_app_pass@localhost:5432/mes_dev

# Role superuser/owner — khusus migrasi (drizzle-kit) & script seed.
# Di prod Neon: gunakan role owner project (atau buat role admin terpisah).
DATABASE_URL_ADMIN=postgres://mes_user:mes_pass@localhost:5432/mes_dev

# Untuk migration (bypass pooling — direct connection)
DATABASE_MIGRATION_URL=postgres://mes_user:mes_pass@localhost:5432/mes_dev

# =============================================================================
# AUTH (JWT + Refresh Token)
# =============================================================================
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_HEX_STRING_MINIMUM_64_CHARS_LENGTH_REQUIRED
JWT_ISSUER=mes.hummer
JWT_AUDIENCE=mes.hummer.api

# Default TTL (SUPERADMIN dapat entry lebih ketat di auth_policy)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# =============================================================================
# 2FA (WhatsApp OTP via Twilio) — SUPERADMIN only
# =============================================================================
# Dev: kosongkan → skip 2FA verification (dummy OTP "000000")
# Prod: WAJIB isi
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886                    # sandbox number, ganti di prod

# TOTP alternative
TOTP_ISSUER="MES Hummer"

# =============================================================================
# QR HMAC (anti-forgery)
# =============================================================================
# Generate: openssl rand -hex 32
# ROTASI SETAHUN — dokumentasikan rotation date
HMAC_KEY_ENCRYPTION=CHANGE_ME_HMAC_ENCRYPTION_KEY

# =============================================================================
# STORAGE (Blob untuk PDF surat jalan, QR image, dsb)
# =============================================================================
# Vercel Blob (recommended) atau S3
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1                           # 10% traces di prod

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# =============================================================================
# EMAIL (untuk password reset — Fase 2+)
# =============================================================================
RESEND_API_KEY=
EMAIL_FROM=noreply@hummer.example

# =============================================================================
# RATE LIMITING (Upstash Redis atau in-memory dev)
# =============================================================================
# Dev: kosongkan → in-memory (tidak persistent)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

RATE_LIMIT_MAX_PER_MINUTE=100
RATE_LIMIT_LOGIN_MAX_PER_MINUTE=10

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_WMS_INBOUND=true                                # Fase 1
FEATURE_MOBILE_QR=false                                 # Fase 3
FEATURE_WMS_OUTBOUND=false                              # Fase 5
FEATURE_DISPATCH=false                                  # Fase 6

# =============================================================================
# DEBUG (dev only)
# =============================================================================
DEBUG=false
DEBUG_SQL=false                                         # log semua SQL query
DEBUG_RLS_BYPASS=false                                  # DANGEROUS — hanya untuk local debug
