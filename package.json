{
  "name": "ohmes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MES + WMS Multi-Cabang — sistem terintegrasi untuk pabrik rokok Hummer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:superadmin": "tsx src/db/seed-superadmin.ts",
    "db:reset": "drizzle-kit drop && drizzle-kit migrate && tsx src/db/seed.ts",
    "postinstall": "echo 'Install complete. Run pnpm dev to start.'"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5",
    "jose": "^5.9.6",
    "bcrypt": "^5.1.1",
    "zod": "^3.24.1",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcrypt": "^5.0.2",
    "typescript": "^5.7.0",
    "tailwindcss": "^3.4.16",
    "tailwind-merge": "^2.6.0",
    "@tailwindcss/forms": "^0.5.9",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "prettier": "^3.4.2"
  }
}
