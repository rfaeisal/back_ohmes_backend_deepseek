{
  "name": "ohmes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MES + WMS Multi-Cabang — sistem terintegrasi untuk pabrik rokok Hummer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/run-seed.ts",
    "db:seed:superadmin": "tsx --env-file=.env src/db/run-seed-superadmin.ts",
    "db:reset": "drizzle-kit drop && drizzle-kit migrate && tsx --env-file=.env src/db/seed.ts",
    "deploy:setup": "pnpm db:migrate && pnpm db:seed",
    "postinstall": "echo 'Install complete. Run pnpm dev to start.'",
    "db:seed:sj-officer": "tsx --env-file=.env src/db/run-seed-sj-officer.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.0",
    "firebase-admin": "^14.3.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.31.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.16.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/forms": "^0.5.9",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
