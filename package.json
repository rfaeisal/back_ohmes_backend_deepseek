{
  "name": "ohmes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MES + WMS Multi-Cabang \u2014 sistem terintegrasi untuk pabrik rokok Hummer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/e2e-reset-db.mjs && playwright test",
    "test:e2e:headed": "node scripts/e2e-reset-db.mjs && playwright test --headed",
    "test:e2e:iterate": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/run-seed.ts",
    "db:seed:superadmin": "tsx --env-file=.env src/db/run-seed-superadmin.ts",
    "db:reset": "drizzle-kit drop && drizzle-kit migrate && tsx --env-file=.env src/db/seed.ts",
    "deploy:setup": "pnpm db:migrate && pnpm db:seed",
    "postinstall": "echo 'Install complete. Run pnpm dev to start.'",
    "db:seed:sj-officer": "tsx --env-file=.env src/db/run-seed-sj-officer.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.3.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.31.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.23",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
